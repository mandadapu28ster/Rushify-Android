<?xml version="1.0" encoding="utf-8"?>
<!-- Users self-host on raw IP:port, so cleartext must be allowed. The app enforces
     URL validation, a one-time confirmation and a persistent warning chip for http://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
